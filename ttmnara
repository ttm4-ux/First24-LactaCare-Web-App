    function openThaiMedDateModal(patientId) {
      currentThaiMedTargetPatientId = patientId;
      const patient = appState.adminPatients.find(p => p.id === patientId);
      const nameEl = document.getElementById('thaiMedModalPatientName');
      if (nameEl) nameEl.innerText = patient ? `${patient.name} (${patient.ward} เตียง ${patient.bed || '-'})` : appState.name;

      const dateInput = document.getElementById('thaiMedApptDateInput');
      if (dateInput) {
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        dateInput.value = tomorrow.toISOString().split('T')[0];
        dateInput.min = new Date().toISOString().split('T')[0];
      }

      document.getElementById('thaiMedDateModal')?.classList.remove('hidden');
    }

    function closeThaiMedDateModal() {
      document.getElementById('thaiMedDateModal')?.classList.add('hidden');
      currentThaiMedTargetPatientId = null;
    }

