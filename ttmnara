    /* Normal Pump Logging */
    function addPumpLog() {
      const side = document.getElementById('pumpSide')?.value || 'สองข้าง';
      const volInput = document.getElementById('pumpVolume');
      let vol = parseFloat(volInput?.value);
      if (isNaN(vol) || vol < 0) vol = 0.0;

      const now = new Date();
      const timeStr = now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });

      const newLog = {
        id: Date.now(),
        time: timeStr,
        side: side,
        volume: vol
      };

      appState.logs.unshift(newLog);
      appState.pumps += 1;
      appState.totalVolume += vol;

      if (volInput) volInput.value = '';

      saveState();
      syncCurrentPatientToAdminList();
      updateTrackerUI();
      showToast('บันทึกรอบการบีบเรียบร้อย');
    }

    function deletePumpLog(id) {
      const idx = appState.logs.findIndex(l => l.id === id);
      if (idx !== -1) {
        const removed = appState.logs.splice(idx, 1)[0];
        appState.pumps = Math.max(0, appState.pumps - 1);
        appState.totalVolume = Math.max(0, appState.totalVolume - removed.volume);
        saveState();
        syncCurrentPatientToAdminList();
        updateTrackerUI();
        showToast('ลบรายการบันทึกแล้ว');
      }
    }

    function updateTrackerUI() {
      const countEl = document.getElementById('pumpCount');
      const volEl = document.getElementById('totalVolume');
      const listEl = document.getElementById('pumpLogList');

      if (countEl) countEl.innerText = appState.pumps;
      if (volEl) volEl.innerText = appState.totalVolume.toFixed(1);

      if (listEl) {
        if (appState.logs.length === 0) {
          listEl.innerHTML = `
            <div class="text-center py-6 text-xs text-slate-400 bg-slate-50/50 rounded-xl border border-dashed border-slate-200">
              ยังไม่มีการบันทึกรอบบีบวันนี้
            </div>
          `;
        } else {
          listEl.innerHTML = appState.logs.map(log => `
            <div class="p-2.5 bg-white rounded-xl border border-slate-200 flex items-center justify-between text-xs">
              <div class="space-y-0.5">
                <div class="flex items-center gap-1.5 font-bold text-slate-800">
                  <span>⏱️ ${log.time} น.</span>
                  <span class="text-[10px] text-slate-500 font-normal">(${log.side})</span>
