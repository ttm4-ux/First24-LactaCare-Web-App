    function syncCurrentPatientToAdminList() {
      if (!appState.name || !appState.ward) return;

      const todayIso = new Date().toISOString().split('T')[0];
      if (!appState.recordDate) {
        appState.recordDate = todayIso;
      }

      const existingIdx = appState.adminPatients.findIndex(p => p.name === appState.name && p.ward === appState.ward);
      const existingPatient = existingIdx !== -1 ? appState.adminPatients[existingIdx] : null;

      const patientRecord = {
        id: existingPatient ? existingPatient.id : 'P_' + Date.now(),
        name: appState.name,
        hn: appState.hn || (existingPatient ? existingPatient.hn : ''),
        ward: appState.ward,
        bed: appState.bed,
        deliveryType: appState.deliveryType || (existingPatient ? existingPatient.deliveryType : ''),
        district: appState.district || (existingPatient ? existingPatient.district : ''),
        recordDate: existingPatient ? (existingPatient.recordDate || appState.recordDate || todayIso) : (appState.recordDate || todayIso),
        provider: appState.provider || (existingPatient ? existingPatient.provider : ''),
        symptoms: appState.symptoms || (existingPatient ? existingPatient.symptoms : 'รอการประเมิน'),
        massagedStimulate: appState.massagedStimulate !== undefined ? appState.massagedStimulate : (existingPatient ? existingPatient.massagedStimulate : null),
        massagedUnclog: appState.massagedUnclog !== undefined ? appState.massagedUnclog : (existingPatient ? existingPatient.massagedUnclog : null),
        lastMassageType: appState.lastMassageType || (existingPatient ? existingPatient.lastMassageType : null),
        lastMassageTime: appState.lastMassageTime || (existingPatient ? existingPatient.lastMassageTime : null),
        lastActionMessage: appState.lastActionMessage || (existingPatient ? existingPatient.lastActionMessage : null),
        lastActionTime: appState.lastActionTime || (existingPatient ? existingPatient.lastActionTime : null),
        thaiMedAppt: appState.thaiMedAppt || (existingPatient ? existingPatient.thaiMedAppt : null),
        pumps: appState.pumps,
        totalVolume: appState.totalVolume,
        logs: appState.logs,
        flowFollowUps: appState.flowFollowUps || (existingPatient ? existingPatient.flowFollowUps : []),
        assessmentScore: appState.assessmentScore,
        assessmentAlert: appState.assessmentAlert,
        lastAssessedTime: appState.lastAssessedTime || 'ยังไม่ระบุ',
        nurseNotes: (appState.nurseNotes && appState.nurseNotes.length > 0) ? appState.nurseNotes : (existingPatient ? existingPatient.nurseNotes : [])
      };

      if (existingIdx !== -1) {
        appState.adminPatients[existingIdx] = patientRecord;
      } else {
        appState.adminPatients.unshift(patientRecord);
      }
      saveState();
    }

    /* อัปเดตผู้ให้บริการ */
    function updatePatientProvider(patientId, providerName) {
      const patient = appState.adminPatients.find(p => p.id === patientId);
      if (patient) {
        patient.provider = providerName;
        if (patient.name === appState.name && patient.ward === appState.ward) {
          appState.provider = providerName;
        }
        saveState();
        showToast(providerName ? `เลือกแพทย์แผนไทย: ${providerName}` : 'ยกเลิกการเลือกแพทย์แผนไทย');
      }
    }

    function toggleAdminMassage(patientId, type) {
      const patient = appState.adminPatients.find(p => p.id === patientId);
      if (!patient) return;

      const now = new Date();
      const timeStr = now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
      if (!patient.nurseNotes) patient.nurseNotes = [];

      let shouldNavigateToTracker = false;
      let massageName = '';
      const providerLabel = patient.provider ? ` (โดย ${patient.provider})` : '';

      if (type === 'stimulate') {
        if (patient.massagedStimulate) {
          patient.massagedStimulate = null;
          if (patient.lastMassageType === 'นวดกระตุ้นน้ำนม') {
            patient.lastMassageType = null;
            patient.lastMassageTime = null;
          }
          showToast('ยกเลิกสถานะนวดกระตุ้นน้ำนม');
        } else {
          patient.massagedStimulate = timeStr;
          patient.lastMassageType = 'นวดกระตุ้นน้ำนม';
          patient.lastMassageTime = timeStr;
          massageName = 'นวดกระตุ้นน้ำนม';
          shouldNavigateToTracker = true;
          patient.nurseNotes.push({
            time: timeStr,
            text: `นวดกระตุ้นการไหลของน้ำนมที่เตียงเรียบร้อย${providerLabel}`
          });
          showToast(`บันทึก: นวดกระตุ้นน้ำนมแล้ว${providerLabel}`);
        }
      } else if (type === 'unclog') {
        if (patient.massagedUnclog) {
          patient.massagedUnclog = null;
          if (patient.lastMassageType === 'นวดเปิดท่อน้ำนม') {
            patient.lastMassageType = null;
            patient.lastMassageTime = null;
          }
          showToast('ยกเลิกสถานะนวดเปิดท่อน้ำนม');
        } else {
          patient.massagedUnclog = timeStr;
          patient.lastMassageType = 'นวดเปิดท่อน้ำนม';
          patient.lastMassageTime = timeStr;
          massageName = 'นวดเปิดท่อน้ำนม';
          shouldNavigateToTracker = true;
          patient.nurseNotes.push({
            time: timeStr,
            text: `นวดเปิดท่อน้ำนมและคลายความคัดตึงเรียบร้อย${providerLabel}`
          });
          showToast(`บันทึก: นวดเปิดท่อน้ำนมแล้ว${providerLabel}`);
        }
      }

      // Synchronize to current active state
      appState.name = patient.name;
      appState.hn = patient.hn || '';
      appState.ward = patient.ward;
      appState.bed = patient.bed || '';
      appState.deliveryType = patient.deliveryType || '';
      appState.district = patient.district || '';
      appState.provider = patient.provider || '';
      appState.symptoms = patient.symptoms || '';
      appState.pumps = patient.pumps || 0;
      appState.totalVolume = patient.totalVolume || 0.0;
      appState.logs = patient.logs || [];
      appState.flowFollowUps = patient.flowFollowUps || [];
      appState.massagedStimulate = patient.massagedStimulate;
      appState.massagedUnclog = patient.massagedUnclog;
      appState.lastMassageType = patient.lastMassageType;
      appState.lastMassageTime = patient.lastMassageTime;

      const nameInput = document.getElementById('patientName');
      const hnInput = document.getElementById('patientHn');
      const wardSelect = document.getElementById('patientWard');
      const bedInput = document.getElementById('patientBed');
      const deliverySelect = document.getElementById('patientDeliveryType');
      const districtSelect = document.getElementById('patientDistrict');
      if (nameInput) nameInput.value = appState.name;
      if (hnInput) hnInput.value = appState.hn;
      if (wardSelect) wardSelect.value = appState.ward;
      if (bedInput) bedInput.value = appState.bed;
      if (deliverySelect) deliverySelect.value = appState.deliveryType;
      if (districtSelect) districtSelect.value = appState.district;

      saveState();
      renderAdminDashboard();
      updateTrackerUI();
      updateFlowMonitoringUI();

      if (shouldNavigateToTracker) {
        setTimeout(() => {
          closeAdminModal();
          switchTab('track');
          showToast(`เปิดหน้าบันทึกการบีบนม: ติดตามผลหลัง${massageName}`);

          const card = document.getElementById('flowMonitoringCard');
          if (card) {
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            card.classList.add('ring-4', 'ring-amber-400', 'ring-offset-2');
            setTimeout(() => {
              card.classList.remove('ring-4', 'ring-amber-400', 'ring-offset-2');
            }, 2500);
          }
        }, 350);
      }
    }

