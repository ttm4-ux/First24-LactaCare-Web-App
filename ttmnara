  </div>

  <script>
    /* Application State */
    const appState = {
      activeTab: 'assess',
      name: '',
      hn: '',
      ward: '',
      bed: '',
      deliveryType: '',
      district: '',
      recordDate: null,
      provider: '',
      symptoms: '',
      assessmentScore: null,
      assessmentAlert: false,
      lastAssessedTime: null,
      massagedStimulate: null,
      massagedUnclog: null,
      lastMassageType: null,
      lastMassageTime: null,
      lastActionMessage: null,
      lastActionTime: null,
      thaiMedAppt: null,
      pumps: 0,
      totalVolume: 0.0,
      logs: [],
      flowFollowUps: [],
      babyPhoto: null,
      isAdminLoggedIn: false,
      adminWardFilter: 'all',
      adminPatients: [],
      nurseNotes: []
    };

    const ADMIN_PIN_DEFAULT = "1234";
    let confirmCallback = null;
    let currentThaiMedTargetPatientId = null;
    let currentAdviceTargetPatientId = null;

    /* Tab Switcher */
    function switchTab(tabId) {
      appState.activeTab = tabId;
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      const activeContent = document.getElementById(`tab-${tabId}`);
      if (activeContent) activeContent.classList.remove('hidden');

      const tabs = ['assess', 'track', 'guide'];
      tabs.forEach(t => {
        // Mobile bottom nav buttons
        const navBtn = document.getElementById(`nav-${t}`);
        if (navBtn) {
          if (t === tabId) {
            navBtn.className = 'flex flex-col items-center py-1 font-bold text-rose-600 transition';
          } else {
            navBtn.className = 'flex flex-col items-center py-1 font-semibold text-slate-400 hover:text-slate-600 transition';
          }
        }

        // Desktop top header buttons
        const deskBtn = document.getElementById(`desk-nav-${t}`);
        if (deskBtn) {
          if (t === tabId) {
            deskBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-rose-600 shadow-2xs transition flex items-center gap-1.5';
          } else {
            deskBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5';
          }
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* Patient Info Synchronization */
    function savePatientInfo() {
      const nameInput = document.getElementById('patientName');
      const hnInput = document.getElementById('patientHn');
      const wardSelect = document.getElementById('patientWard');
      const bedInput = document.getElementById('patientBed');
      const deliverySelect = document.getElementById('patientDeliveryType');
      const districtSelect = document.getElementById('patientDistrict');

      if (nameInput) appState.name = nameInput.value.trim();
      if (hnInput) appState.hn = hnInput.value.trim();
      if (wardSelect) appState.ward = wardSelect.value;
      if (bedInput) appState.bed = bedInput.value.trim();
      if (deliverySelect) appState.deliveryType = deliverySelect.value;
      if (districtSelect) appState.district = districtSelect.value;

      saveState();
      syncCurrentPatientToAdminList();
    }

    function calculateAssessment() {
      const name = document.getElementById('patientName')?.value.trim();
      const hn = document.getElementById('patientHn')?.value.trim();
      const ward = document.getElementById('patientWard')?.value;
      const bed = document.getElementById('patientBed')?.value.trim();
      const deliveryType = document.getElementById('patientDeliveryType')?.value;
      const district = document.getElementById('patientDistrict')?.value;

      if (!name) {
        showToast('กรุณากรอกชื่อ - นามสกุล คุณแม่');
        document.getElementById('patientName')?.focus();
        return;
      }
      if (!hn) {
        showToast('กรุณากรอก HN คุณแม่');
        document.getElementById('patientHn')?.focus();
        return;
      }
      if (!ward) {
        showToast('กรุณาเลือกตึก / หอผู้ป่วย');
        document.getElementById('patientWard')?.focus();
        return;
      }
      if (!bed) {
        showToast('กรุณากรอกเลขเตียง');
        document.getElementById('patientBed')?.focus();
        return;
      }
      if (!deliveryType) {
        showToast('กรุณาเลือกวิธีการคลอด (คลอดปกติ หรือ ผ่าคลอด)');
        document.getElementById('patientDeliveryType')?.focus();
        return;
      }
      if (!district) {
        showToast('กรุณาเลือกที่อยู่ (อำเภอใน จ.นราธิวาส)');
        document.getElementById('patientDistrict')?.focus();
        return;
      }

      appState.name = name;
      appState.hn = hn;
      appState.ward = ward;
      appState.bed = bed;
      appState.deliveryType = deliveryType;
