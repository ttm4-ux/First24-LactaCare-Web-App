    function saveFlowFollowUp() {
      const selectedStage = document.querySelector('input[name="flowStage"]:checked')?.value || 'หลังนวดทันที';
      const selectedRadio = document.querySelector('input[name="flowResult"]:checked');
      const flowResult = selectedRadio ? selectedRadio.value : 'สังเกตการไหล';
      const volInput = document.getElementById('flowLoggedVol');
      let vol = parseFloat(volInput?.value);
      if (isNaN(vol) || vol < 0) vol = 0.0;

      const now = new Date();
      const timeStr = now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
      const massageLabel = appState.lastMassageType ? `หลัง${appState.lastMassageType}` : 'หลังดูแลเต้า';

      // Log into pump tracker
      const newLog = {
        id: Date.now(),
        time: timeStr,
        side: `${massageLabel} [${selectedStage}] (${flowResult})`,
        volume: vol
      };

      appState.logs.unshift(newLog);
      appState.pumps += 1;
      appState.totalVolume += vol;

      if (!appState.flowFollowUps) appState.flowFollowUps = [];
      
      const existingIdx = appState.flowFollowUps.findIndex(f => f.stage === selectedStage);
      const followUpData = {
        stage: selectedStage,
        time: timeStr,
        massageType: appState.lastMassageType || 'นวดกระตุ้น/เปิดท่อ',
        result: flowResult,
        volume: vol
      };

      if (existingIdx !== -1) {
        appState.flowFollowUps[existingIdx] = followUpData;
      } else {
        appState.flowFollowUps.push(followUpData);
      }

      if (!appState.nurseNotes) appState.nurseNotes = [];
      appState.nurseNotes.push({
        time: timeStr,
        text: `🌊 ติดตามผล [${selectedStage}]: ${flowResult} (${vol.toFixed(1)} มล.)`
      });

      if (volInput) volInput.value = '';

      saveState();
      syncCurrentPatientToAdminList();
      updateTrackerUI();
      updateFlowMonitoringUI();
      showToast(`บันทึกผลการติดตาม: ${selectedStage} เรียบร้อย`);
    }

