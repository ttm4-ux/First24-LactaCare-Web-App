<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>อุ่นไอรัก นมแม่ 24 ชม. - First24 LactaCare</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Sarabun', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
      padding-bottom: env(safe-area-inset-bottom, 20px);
    }
    h1, h2, h3, h4, .font-heading {
      font-family: 'Prompt', sans-serif;
    }
    .safe-bottom {
      padding-bottom: calc(5rem + env(safe-area-inset-bottom, 16px));
    }
    @media (min-width: 768px) {
      .safe-bottom {
        padding-bottom: 2.5rem;
      }
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background-color: #cbd5e1;
      border-radius: 9999px;
    }
    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.6); }
      70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
      100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
    .highlight-ring {
      animation: pulse-ring 1.8s infinite;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased selection:bg-rose-200">
  <!-- Header Bar: Responsive for Mobile and PC -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-rose-100 shadow-xs">
    <div class="max-w-5xl mx-auto px-4 py-2.5 flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl bg-gradient-to-tr from-rose-500 to-amber-400 flex items-center justify-center text-white text-lg md:text-xl shadow-sm">
          🤱
        </div>
        <div>
          <h1 class="text-sm md:text-base font-bold text-slate-800 leading-tight">อุ่นไอรัก นมแม่ 24 ชม.</h1>
          <p class="text-[10px] md:text-xs text-rose-600 font-medium">ดูแลคุณแม่หลังคลอดที่ลูกแยกกับแม่ - First24 LactaCare</p>
        </div>
      </div>
      
      <!-- Desktop Navigation Tabs (Visible on PC) -->
      <nav class="hidden md:flex items-center gap-1.5 bg-slate-100/80 p-1 rounded-xl border border-slate-200">
        <button onclick="switchTab('assess')" id="desk-nav-assess" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-rose-600 shadow-2xs transition flex items-center gap-1.5">
          <span>🩺</span>
          <span>แบบประเมิน</span>
        </button>
        <button onclick="switchTab('track')" id="desk-nav-track" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5">
          <span>💉</span>
          <span>บันทึกการบีบนม</span>
        </button>
        <button onclick="switchTab('guide')" id="desk-nav-guide" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5">
          <span>📖</span>
          <span>คู่มือความรู้</span>
        </button>
      </nav>

      <div class="flex items-center gap-1.5">
        <button onclick="openBabyPhotoModal()" class="px-2.5 py-1.5 md:px-3 md:py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-[11px] md:text-xs font-semibold flex items-center gap-1 border border-rose-200 transition active:scale-95 shadow-2xs">
          <span>👶</span>
          <span>คิดถึงลูก</span>
        </button>
        <button onclick="openAdminModal()" class="px-2.5 py-1.5 md:px-3 md:py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-[11px] md:text-xs font-semibold flex items-center gap-1 shadow-xs transition active:scale-95">
          <span>👩‍⚕️</span>
          <span>Admin</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-5xl w-full mx-auto p-4 md:p-6 safe-bottom">

    <!-- ==================== TAB 1: แบบประเมิน (ASSESSMENT VIEW) ==================== -->
    <section id="tab-assess" class="tab-content space-y-4">
      <div class="md:grid md:grid-cols-12 md:gap-6 space-y-4 md:space-y-0 items-start">
        
        <!-- Left Column on PC: Banner & Form Questions -->
        <div class="md:col-span-7 space-y-4">
          <!-- Banner ความรู้ขนาดกระเพาะ -->
          <div class="bg-gradient-to-br from-amber-500 to-rose-500 rounded-2xl p-4 md:p-5 text-white shadow-md relative overflow-hidden">
            <div class="relative z-10 space-y-1.5 max-w-md">
              <div class="inline-flex items-center gap-1 bg-white/20 backdrop-blur-md px-2.5 py-0.5 rounded-full text-[10px] md:text-[11px] font-semibold">
                <span>🍒</span>
                <span>ความลับ 24 ชั่วโมงแรก</span>
              </div>
              <h2 class="text-base md:text-lg font-bold leading-snug">กระเพาะลูกวันแรกเท่า "ลูกเชอร์รี่"</h2>
              <p class="text-xs md:text-sm text-rose-50 leading-relaxed opacity-95">
                จุได้เพียง 5-7 มล. (~1 ช้อนชา) หัวน้ำนม (Colostrum) จึงมาเป็นหยดเล็กๆ สีเหลืองทองเพื่อลูก ไม่ต้องกังวลว่าน้ำนมยังไม่พุ่งนะครับ
              </p>
            </div>
            <div class="absolute -right-4 -bottom-4 text-7xl md:text-8xl opacity-20 select-none">🍒</div>
          </div>

          <!-- ฟอร์มระบุข้อมูลคุณแม่ -->
          <div class="bg-white rounded-2xl p-4 shadow-xs border border-rose-100 space-y-3">
            <h3 class="text-xs md:text-sm font-bold text-slate-800 flex items-center gap-1.5">
              <span>📋</span>
              <span>ข้อมูลคุณแม่ & หอผู้ป่วย</span>
            </h3>
            
            <div class="space-y-2.5">
              <div class="grid grid-cols-3 gap-2">
                <div class="col-span-2">
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">ชื่อ - นามสกุล คุณแม่ <span class="text-rose-500">*</span></label>
                  <input type="text" id="patientName" oninput="savePatientInfo()" placeholder="เช่น น.ส. สมใจ รักดี" 
                         class="w-full text-xs md:text-sm px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-400 bg-slate-50/50">
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">HN <span class="text-rose-500">*</span></label>
                  <input type="text" id="patientHn" oninput="savePatientInfo()" placeholder="เช่น 67xxxxx" 
                         class="w-full text-xs md:text-sm px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-400 bg-slate-50/50">
                </div>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">ตึก / หอผู้ป่วย <span class="text-rose-500">*</span></label>
                  <select id="patientWard" onchange="savePatientInfo()" 
                          class="w-full text-xs md:text-sm px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-400 bg-white">
                    <option value="">-- เลือกตึก --</option>
                    <option value="นวมินทร์ 3">นวมินทร์ 3</option>
                    <option value="นวมินทร์ 4">นวมินทร์ 4</option>
                    <option value="เปี่ยมสุข 2">เปี่ยมสุข 2</option>
                    <option value="ประชารักษ์ 4">ประชารักษ์ 4</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">เลขเตียง <span class="text-rose-500">*</span></label>
                  <input type="text" id="patientBed" oninput="savePatientInfo()" placeholder="เช่น 05, 12" 
                         class="w-full text-xs md:text-sm px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-400 bg-slate-50/50">
                </div>
                <div class="col-span-2 sm:col-span-1">
                  <label class="block text-[11px] font-semibold text-slate-600 mb-1">วิธีการคลอด <span class="text-rose-500">*</span></label>
                  <select id="patientDeliveryType" onchange="savePatientInfo()" 
                          class="w-full text-xs md:text-sm px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-400 bg-white">
                    <option value="">-- วิธีการคลอด --</option>
                    <option value="คลอดปกติ">คลอดปกติ</option>
                    <option value="ผ่าคลอด">ผ่าคลอด</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-semibold text-slate-600 mb-1">ที่อยู่ (อำเภอใน จ.นราธิวาส) <span class="text-rose-500">*</span></label>
                <select id="patientDistrict" onchange="savePatientInfo()" 
                        class="w-full text-xs md:text-sm px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-400 bg-white">
                  <option value="">-- เลือกอำเภอใน จ.นราธิวาส --</option>
                  <option value="อำเภอเมืองนราธิวาส">อำเภอเมืองนราธิวาส</option>
                  <option value="อำเภอตากใบ">อำเภอตากใบ</option>
                  <option value="อำเภอบาเจาะ">อำเภอบาเจาะ</option>
                  <option value="อำเภอยี่งอ">อำเภอยี่งอ</option>
                  <option value="อำเภอระแงะ">อำเภอระแงะ</option>
                  <option value="อำเภอรือเสาะ">อำเภอรือเสาะ</option>
                  <option value="อำเภอศรีสาคร">อำเภอศรีสาคร</option>
                  <option value="อำเภอแว้ง">อำเภอแว้ง</option>
                  <option value="อำเภอสุคิริน">อำเภอสุคิริน</option>
                  <option value="อำเภอสุไหงโก-ลก">อำเภอสุไหงโก-ลก</option>
                  <option value="อำเภอสุไหงปาดี">อำเภอสุไหงปาดี</option>
                  <option value="อำเภอจะแนะ">อำเภอจะแนะ</option>
                  <option value="อำเภอเจาะไอร้อง">อำเภอเจาะไอร้อง</option>
                </select>
              </div>
            </div>
          </div>

          <!-- แบบสอบถาม 4 ข้อ -->
          <div class="bg-white rounded-2xl p-4 shadow-xs border border-rose-100 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
              <h3 class="text-xs md:text-sm font-bold text-slate-800 flex items-center gap-1.5">
                <span>🩺</span>
                <span>แบบประเมินการไหลของน้ำนม (24 ชม. แรก)</span>
              </h3>
              <span class="text-[10px] text-slate-400">4 ข้อคำถาม</span>
            </div>

            <!-- ข้อ 1 -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">1. เวลาเริ่มบีบกระตุ้นน้ำนมครั้งแรกหลังคลอด</label>
              <div class="space-y-1.5 text-xs">
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q1" value="fast" class="accent-rose-500 mr-2.5" checked>
                  <span>เริ่มบีบภายใน 1 - 2 ชั่วโมงแรกหลังคลอด (Golden Hour)</span>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q1" value="moderate" class="accent-rose-500 mr-2.5">
                  <span>เริ่มบีบใน 2 - 6 ชั่วโมงหลังคลอด</span>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q1" value="late" class="accent-rose-500 mr-2.5">
                  <span>เกิน 6 ชั่วโมง หรือยังไม่ได้เริ่มบีบกระตุ้นเลย</span>
                </label>
              </div>
            </div>

            <!-- ข้อ 2 -->
            <div class="space-y-1.5 pt-1">
              <label class="block text-xs font-semibold text-slate-700">2. ลักษณะและปริมาณน้ำนมที่สังเกตเห็น</label>
              <div class="space-y-1.5 text-xs">
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q2" value="good_flow" class="accent-rose-500 mr-2.5" checked>
                  <div>
                    <p class="font-medium text-slate-800">หยดสีเหลืองทอง 0.1 - 2 มล. ขึ้นไป</p>
                    <p class="text-[10px] text-slate-500">ซึมเป็นหยด ใช้ปลาย Syringe จ่อดูดได้</p>
                  </div>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q2" value="drop_flow" class="accent-rose-500 mr-2.5">
                  <div>
                    <p class="font-medium text-slate-800">เคลือบปลายหัวนม หรือเป็นเม็ดเหงื่อ</p>
                    <p class="text-[10px] text-slate-500">ซึมเป็นละอองหรือเม็ดเหงื่อเล็กๆ ที่ลานนม</p>
                  </div>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q2" value="engorged" class="accent-rose-500 mr-2.5">
                  <div>
                    <p class="font-medium text-amber-700 font-semibold">เต้านมคัดตึง</p>
                    <p class="text-[10px] text-slate-500">เต้านมเริ่มแข็ง แน่น ตึง หรือบีบออกยาก</p>
                  </div>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q2" value="no_milk" class="accent-rose-500 mr-2.5">
                  <div>
                    <p class="font-medium text-blue-700 font-semibold">ไม่มีน้ำนม</p>
                    <p class="text-[10px] text-slate-500">ยังไม่มีน้ำนมไหลออกมาเลย หรือแห้งสนิท (ปกติใน 24 ชม. แรก)</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- ข้อ 3 -->
            <div class="space-y-1.5 pt-1">
              <label class="block text-xs font-semibold text-slate-700">3. ความถี่ในการบีบกระตุ้นเต้าในรอบวันนี้</label>
              <div class="space-y-1.5 text-xs">
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q3" value="frequent" class="accent-rose-500 mr-2.5" checked>
                  <span>บีบสม่ำเสมอทุก 2 - 3 ชั่วโมง (เป้าหมาย 8 - 10 รอบ/วัน)</span>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q3" value="average" class="accent-rose-500 mr-2.5">
                  <span>บีบได้ 4 - 7 รอบต่อวัน</span>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q3" value="low" class="accent-rose-500 mr-2.5">
                  <span>บีบน้อยกว่า 4 รอบ หรือยังไม่ได้บีบเลย</span>
                </label>
              </div>
            </div>

            <!-- ข้อ 4 -->
            <div class="space-y-1.5 pt-1">
              <label class="block text-xs font-semibold text-slate-700">4. สภาพจิตใจและความรู้สึกของคุณแม่</label>
              <div class="space-y-1.5 text-xs">
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q4" value="relaxed" class="accent-rose-500 mr-2.5" checked>
                  <span>ผ่อนคลาย มั่นใจ มีกำลังใจดีพร้อมส่งน้ำนมให้ลูก</span>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q4" value="mild_anxiety" class="accent-rose-500 mr-2.5">
                  <span>กังวลเล็กน้อย คิดถึงลูกมาก อยากเจอลูก</span>
                </label>
                <label class="flex items-center p-2.5 rounded-xl border border-slate-200 hover:bg-rose-50/50 cursor-pointer has-checked:border-rose-500 has-checked:bg-rose-50/70 transition">
                  <input type="radio" name="q4" value="stressed" class="accent-rose-500 mr-2.5">
                  <span>เครียด วิตกกังวลมาก กลัวน้ำนมไม่พอ หรือพักผ่อนไม่เพียงพอ</span>
                </label>
              </div>
            </div>

            <button onclick="calculateAssessment()" class="w-full bg-gradient-to-r from-rose-500 to-amber-500 hover:from-rose-600 hover:to-amber-600 text-white font-bold py-3 px-4 rounded-xl shadow-md text-xs md:text-sm flex items-center justify-center gap-2 transition active:scale-[0.98]">
              <span>✨</span>
              <span>ประมวลผลการประเมิน</span>
            </button>
          </div>
        </div>

        <!-- Right Column on PC: Assessment Result Card & Quick Advice -->
        <div class="md:col-span-5 space-y-4 md:sticky md:top-20">
          <div id="assessmentResultCard" class="hidden bg-white rounded-2xl p-4 md:p-5 shadow-sm border border-slate-200 space-y-3.5 transition-all">
            <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-xl border border-slate-200 text-xs">
              <div>
                <span class="font-bold text-slate-800" id="resPatientName">-</span>
                <span class="text-[10px] text-slate-500 font-semibold ml-1 px-1.5 py-0.5 rounded bg-white border border-slate-200" id="resPatientHn">HN: -</span>
                <span class="text-slate-500 ml-1.5 block sm:inline mt-0.5 sm:mt-0" id="resPatientBed">ตึก: - | เตียง: -</span>
              </div>
              <span id="resScoreBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                ปกติ
              </span>
            </div>

            <div class="space-y-1.5">
              <h4 id="resTitle" class="text-xs md:text-sm font-bold text-slate-900 leading-snug">ผลการประเมินการไหลของน้ำนม</h4>
              <p id="resDescription" class="text-xs text-slate-600 leading-relaxed"></p>
            </div>

            <div id="resAdviceBox" class="p-3 rounded-xl bg-amber-50/80 border border-amber-200 text-xs text-amber-900 space-y-1 leading-relaxed">
            </div>

            <button onclick="switchTab('track')" class="w-full bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white font-bold py-2.5 px-4 rounded-xl shadow-sm text-xs md:text-sm flex items-center justify-center gap-1.5 transition">
              <span>💉</span>
              <span>บันทึกการบีบนม</span>
            </button>
          </div>

          <!-- Quick Tip for Desktop side panel -->
